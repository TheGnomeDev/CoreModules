<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-shrink: 0; flex-grow: 0; flex-basis: 100%; width: 100%; height: 100%; align-content: auto; align-items: center; justify-content: center;">
        <ui:GroupBox enabled="true" name="GroupBox" style="justify-content: space-between; align-content: auto; align-items: center; display: flex; flex-direction: row; flex-shrink: 0; flex-grow: 0; align-self: stretch; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 1%; padding-bottom: 0; padding-left: 1%; flex-basis: 100%; width: 100%; height: 100%;">
            <ui:Toggle focusable="false" name="Selectionbox" style="background-color: rgb(188, 188, 188); -unity-background-image-tint-color: rgb(193, 14, 14); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; aspect-ratio: 1;"/>
            <ui:Label text="Label" name="TagValue" triple-click-selects-line="false" double-click-selects-word="false" style="flex-shrink: 0; flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 2%; font-size: 16px; -unity-text-align: middle-left;"/>
            <ui:Button text="+" name="AddButton" focusable="false" style="aspect-ratio: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 80%; min-height: 15px; min-width: 15px; border-left-color: rgb(74, 74, 74); border-right-color: rgb(74, 74, 74); border-top-color: rgb(74, 74, 74); border-bottom-color: rgb(74, 74, 74); border-top-left-radius: 5%; border-top-right-radius: 5%; border-bottom-right-radius: 5%; border-bottom-left-radius: 5%; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; font-size: 22px;"/>
            <ui:Button text="-" name="RemoveButton" focusable="false" style="aspect-ratio: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 80%; min-height: 15px; min-width: 15px; border-left-color: rgb(74, 74, 74); border-right-color: rgb(74, 74, 74); border-top-color: rgb(74, 74, 74); border-bottom-color: rgb(74, 74, 74); border-top-left-radius: 5%; border-top-right-radius: 5%; border-bottom-right-radius: 5%; border-bottom-left-radius: 5%; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; font-size: 24px;"/>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
